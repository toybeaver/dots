# sway config for the greetd greeter session.
#
# greetd launches this via `sway --config /etc/greetd/sway-config`. The
# "; swaymsg exit" is load-bearing: sway must terminate once the greeter
# finishes, or the login never completes.

# Backdrop behind the greeter. The greeter draws its own full-screen background,
# so this only matters for the moment before it maps.
output * bg #06080c solid_color

# Quickshell greeter. gtkgreet is kept installed alongside as a fallback — see
# the FALLBACK note below.
exec "quickshell -p /etc/greetd/quickshell/shell.qml; swaymsg exit"

# FALLBACK
# If the Quickshell greeter ever fails to start you get a bare sway session with
# no way to log in. Recover from a TTY (Ctrl+Alt+F2), log in, and swap the exec
# line above for the gtkgreet one below, then `sudo systemctl restart greetd`:
#
#   exec "GTK_THEME=Adwaita:dark gtkgreet -l -s /etc/greetd/gtkgreet.css; swaymsg exit"
#
# gtkgreet and its stylesheet are installed by install.sh precisely so this
# fallback is always one edit away.

bindsym Mod4+shift+e exec swaynag \
	-t warning \
	-m 'What do you want to do?' \
	-b 'Poweroff' 'systemctl poweroff' \
	-b 'Reboot' 'systemctl reboot'

include /etc/sway/config.d/*
