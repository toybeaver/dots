/* Rofi — neo-brutalist launcher, dark twin.
 *
 * A THEME file, loaded by ../../../.config/rofi/config.rasi through the
 * active-theme symlink. Appearance only.
 *
 * Square, opaque, thick-bordered. `transparency: "real"` is still required or
 * rofi composites against a backing of its own choosing and fills the corners.
 *
 * ---------------------------------------------------------------------------
 * This mirrors the shell's CONTROL PANEL, not its tiles, and the distinction is
 * the whole design:
 *
 *   the window    is a large dark container floating on the desktop, so it
 *                 takes a light border — the same treatment ControlPanel gets.
 *                 An ink border would be invisible here, exactly as it was on
 *                 mako, because there is no panel behind it to read against.
 *   a row         sits ON that container, so it follows the tile rule: a
 *                 coloured block carrying near-black ink.
 *
 * Getting those the wrong way round is what the previous version did — it kept
 * the pre-restructure palette, so the selected row was a cyan block with
 * off-white text on it, which is the one combination this theme never uses.
 */

* {
    /* The container. Matches `panel` in consts/Theme.qml, opaque. */
    surface:     #0D0D10FF;

    /* Border for the container. It has only the desktop behind it, so it has to
     * be light enough to read against near-black — but it does not have to be
     * neutral. `acc_violet`, matching the selection and the window borders
     * Hyprland draws, so the launcher belongs to the same family as everything
     * else that frames something.
     *
     * Deliberately the same hue as the selected row rather than a second
     * colour: the theme spends hue on meaning, and "this is the launcher" and
     * "this is the choice" are the same statement. */
    rim:         #9784D9FF;

    /* A quiet divider tone for the input box, tinted the same way but well
     * below the rim, so the field reads as recessed rather than as a second
     * window. */
    rim-dim:     #4A4459FF;

    /* Text ON the container. */
    fg:          #F2EDE3;
    fg-dim:      #8C877DFF;

    /* The selection is a coloured block, so it carries near-black ink like
     * every other block in the theme. `on_block` from the palette. */
    accent:      #9784D9FF;
    on-accent:   #0C0C0CFF;
    ink:         #08080AFF;

    transparent: #00000000;

    background-color: @transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @surface;
    border:           4px;
    border-color:     @rim;
    border-radius:    0;
    width:            42%;
    padding:          0;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  16px;
    spacing:  14px;
}

/* A boxed field, not an underline. Every element in this style is a block with
 * its own border. */
inputbar {
    children:     [ prompt, entry ];
    spacing:      10px;
    padding:      10px 12px;
    border:       3px;
    border-color: @rim-dim;
}

prompt {
    font:           "Adwaita Sans Bold 13";
    text-color:     @fg-dim;
    vertical-align: 0.5;
}

entry {
    font:              "Noto Sans 12";
    text-color:        @fg;
    placeholder:       "SEARCH";
    placeholder-color: @fg-dim;
    cursor-color:      @fg;
    vertical-align:    0.5;
}

listview {
    lines:     14;
    columns:   1;
    scrollbar: false;
    spacing:   4px;

    /* rofi's built-in default is `border: 2px dash 0px 0px`, which draws a
     * dashed rule under the input bar. Cleared explicitly or you get one. */
    border:    0;
}

element {
    padding:       8px 10px;
    border-radius: 0;
    spacing:       8px;
}

element normal.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @transparent;
    text-color:       @fg;
}

/* The selected row is a filled block with a hard ink border — a tile sitting on
 * the container, following the same rule as every tile in the shell. */
element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
    border:           3px;
    border-color:     @ink;
}

element-text {
    font:             "Noto Sans 12";
    text-color:       inherit;
    background-color: @transparent;
    vertical-align:   0.5;
}
