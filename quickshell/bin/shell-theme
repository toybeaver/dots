#!/bin/sh
#
# Theme launcher and switcher for the Quickshell desktop.
#
# Each theme is a whole Quickshell config directory (see THEMES), so switching
# means replacing the running process rather than reloading anything. This
# script is the one place that knows which themes exist and which one is
# selected; hyprland.lua goes through it for both autostart and the control
# center keybind, so neither has to name a theme.
#
#   shell-theme start           bring the whole desktop up (autostart)
#   shell-theme next | prev     step through THEMES and switch into it
#   shell-theme set <name>      switch to a specific theme
#   shell-theme apply           re-apply the current theme without restarting it
#   shell-theme lock            lock the session with the active theme's locker
#   shell-theme current         print the saved theme
#   shell-theme list            print every theme, one per line
#   shell-theme ipc ...         forward an IPC call to the running theme
#
# A theme is more than the shell. Each one carries its own wallpaper, mako
# config, rofi theme and Hyprland style block under <theme>/desktop/, and this
# script owns every program whose appearance depends on them — swaybg, mako and
# the shell itself. That is why hyprland.lua's autostart is a single line: there
# should be exactly one place that knows how to bring the desktop up, and it
# should be the same code path a switch goes through.
#
set -eu

# Order matters: this is the order the control center's < and > buttons walk.
THEMES="hxh-neon-glass neo-brutal neo-brutal-dark"
DEFAULT_THEME="hxh-neon-glass"

# Resolved from this script's own location so the themes are found whether it is
# run through the ~/.config/quickshell symlink or straight out of the repo.
THEME_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

WALLPAPER_DIR="$HOME/Pictures/wallpaper"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dots"
STATE_FILE="$STATE_DIR/theme"

# Stable paths for the theme's assets, repointed on every switch. Programs that
# cannot be told about themes — rofi's config, and mako, which has no include
# directive — reference these instead of a theme directory, so nothing outside
# this script ever names a theme.
ACTIVE_DIR="$STATE_DIR/active"

# A switch replaces the process running the switcher, so a failure has nowhere
# to report itself — no terminal, and the UI that asked for it is already gone.
# This file is the only account of what happened.
LOG_FILE="$STATE_DIR/shell-theme.log"

log() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE"
}

die() { printf 'shell-theme: %s\n' "$1" >&2; exit 1; }

is_theme() {
  for t in $THEMES; do
    [ "$t" = "$1" ] && return 0
  done
  return 1
}

# The saved theme, falling back to the default whenever the state file is
# missing or names something that no longer exists — a theme can be deleted
# out from under it, and the shell still has to start.
current_theme() {
  if [ -r "$STATE_FILE" ]; then
    saved=$(cat "$STATE_FILE" 2>/dev/null || true)
    if is_theme "$saved"; then
      printf '%s\n' "$saved"
      return
    fi
  fi
  printf '%s\n' "$DEFAULT_THEME"
}

# PIDs of running shells for theme $1.
#
# Read out of quickshell's own instance list rather than matched against the
# command line, because `quickshell kill -c <name>` resolves the config
# directory first and so cannot touch an instance whose directory was renamed
# or deleted while it ran — exactly what happens mid-rename.
theme_pids() {
  quickshell list --all 2>/dev/null | awk -v want="/$1/shell.qml" '
    /^[[:space:]]*Process ID:/ { pid = $3 }
    index($0, want) && pid    { print pid; pid = "" }
  '
}

# Stop every theme shell, leaving the lock screen (a config, but not a theme)
# alone. Waits for them to actually exit: a new shell that starts while the old
# one still holds its layer surface gets a doubled sidebar and a doubled
# exclusive zone.
stop_themes() {
  for t in $THEMES; do
    for pid in $(theme_pids "$t"); do
      quickshell kill --pid "$pid" >/dev/null 2>&1 || true
    done
  done

  i=0
  while [ "$i" -lt 50 ]; do
    alive=""
    for t in $THEMES; do
      [ -n "$(theme_pids "$t")" ] && alive=1
    done
    [ -z "$alive" ] && return 0
    i=$((i + 1))
    sleep 0.1
  done
}

step_theme() {
  cur=$(current_theme)

  count=0
  index=1
  for t in $THEMES; do
    count=$((count + 1))
    [ "$t" = "$cur" ] && index=$count
  done

  target=$(( (index - 1 + $1 + count) % count + 1 ))

  i=0
  for t in $THEMES; do
    i=$((i + 1))
    if [ "$i" -eq "$target" ]; then
      printf '%s\n' "$t"
      return
    fi
  done
}

# ---------------------------------------------------------------------------
# The desktop around the shell
# ---------------------------------------------------------------------------

# Repoint the stable asset paths at theme $1.
link_assets() {
  mkdir -p "$ACTIVE_DIR"
  for asset in mako.conf rofi.rasi hypr.lua; do
    src="$THEME_ROOT/$1/desktop/$asset"
    if [ -r "$src" ]; then
      ln -sfn "$src" "$ACTIVE_DIR/$asset"
    else
      log "warning: $1 has no desktop/$asset"
    fi
  done
}

# Rebuild swaybg for theme $1.
#
# swaybg has no reload, so this is always a restart. Missing images are skipped
# rather than fatal: the wallpaper directory is not in the repo, so a fresh
# checkout has none of them and must still reach a usable desktop.
apply_wallpaper() {
  # Captured before the `set --` below, which replaces this function's own
  # positional parameters while the swaybg argument list is built.
  theme=$1

  manifest="$THEME_ROOT/$theme/desktop/wallpaper"
  [ -r "$manifest" ] || { log "warning: $theme has no desktop/wallpaper"; return 0; }

  set --
  while read -r output image _rest; do
    case "$output" in ''|\#*) continue ;; esac
    [ -n "$image" ] || continue

    path="$WALLPAPER_DIR/$image"
    if [ ! -r "$path" ]; then
      log "warning: wallpaper $image not found for output $output"
      continue
    fi
    set -- "$@" -o "$output" -i "$path"
  done < "$manifest"

  [ "$#" -gt 0 ] || { log "warning: no usable wallpaper for $theme"; return 0; }

  pkill -x swaybg >/dev/null 2>&1 || true
  setsid swaybg "$@" >/dev/null 2>&1 &
}

# Start mako, or reload it in place if it is already up.
#
# Reload is preferred so a switch does not drop notifications that are on screen.
# mako re-reads the --config path it was started with, and that path is a
# symlink link_assets has already repointed, so a reload picks up the new theme.
# A running mako only counts if it was started with OUR config path. One
# started any other way — by hand, or by an older autostart line — is reloading
# a file we do not control, and since the per-theme configs moved out of
# ~/.config/mako that file may not exist at all. Restart those.
apply_mako() {
  for pid in $(pgrep -x mako 2>/dev/null || true); do
    if tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qxF "$ACTIVE_DIR/mako.conf"; then
      makoctl reload >/dev/null 2>&1 || true
      return 0
    fi
  done

  pkill -x mako >/dev/null 2>&1 || true
  setsid mako --config "$ACTIVE_DIR/mako.conf" >/dev/null 2>&1 &
}

# Push the theme's Hyprland block.
#
# hyprland.lua dofiles ACTIVE_DIR/hypr.lua at parse time, so a reload is all it
# takes. `hyprctl reload` does NOT re-run the autostart hook — verified, and
# load-bearing: if it did, every switch would launch a second shell, mako and
# swaybg, and the switch would recurse.
apply_hypr() {
  hyprctl reload >/dev/null 2>&1 || true
}

# Everything about a theme except the shell process itself.
apply_desktop() {
  link_assets "$1"
  apply_wallpaper "$1"
  apply_mako
  apply_hypr
}

# Launch a theme fully detached and report whether it actually came up.
#
# setsid rather than a plain background job: this script is about to exit, and
# the new shell must not be tied to its lifetime in any way.
launch() {
  setsid quickshell -c "$1" >/dev/null 2>&1 &

  i=0
  while [ "$i" -lt 60 ]; do
    [ -n "$(theme_pids "$1")" ] && return 0
    i=$((i + 1))
    sleep 0.1
  done
  return 1
}

switch_to() {
  is_theme "$1" || die "unknown theme: $1 (have: $THEMES)"

  previous=$(current_theme)

  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$1" > "$STATE_FILE"

  stop_themes
  apply_desktop "$1"

  if launch "$1"; then
    log "switched to $1"
    return 0
  fi

  # The switcher lives INSIDE the shell, so a switch that fails to come up
  # leaves no way to switch back — no bar, no control center, no keybind. Put
  # the old theme back rather than leaving the desktop with nothing.
  log "FAILED to start $1, falling back to $previous"
  printf '%s\n' "$previous" > "$STATE_FILE"
  apply_desktop "$previous"

  if ! launch "$previous"; then
    log "FAILED to restore $previous — no shell is running"
  fi

  return 1
}

# Whether this process is already the detached half of a switch.
#
# An ARGUMENT, never an environment variable. This was an exported env var
# once, and it leaked: the script launches the new shell, the new shell
# inherits the exported flag, and when it later spawns this script the detach
# branch is skipped. The script then runs as a direct child of the Quickshell
# it is about to kill, and dies with it — after writing the state file but
# before starting the replacement, leaving no shell at all.
#
# The tell was that the first switch after login always worked and the second
# never did. An argument cannot leak into a grandchild's environment.
detached=0
if [ "${1:-}" = "--detached" ]; then
  detached=1
  shift
fi

cmd=${1:-start}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$cmd" in
  start)
    theme=$(current_theme)
    log "start: $theme"
    apply_desktop "$theme"
    exec quickshell -c "$theme"
    ;;

  apply)
    # Re-apply wallpaper, mako, rofi and Hyprland for the running theme without
    # touching the shell. Useful after editing a theme's desktop/ files.
    theme=$(current_theme)
    log "apply: $theme"
    apply_desktop "$theme"
    ;;

  set | next | prev)
    # We are about to kill the Quickshell instance that spawned us — the theme
    # switcher runs this from inside the shell it is replacing. Without
    # detaching first, this script dies alongside it and nothing ever starts
    # the replacement, leaving the desktop with no shell at all.
    if [ "$detached" -ne 1 ]; then
      # Output goes to the log, NOT to /dev/null. Nothing is watching this
      # process: its parent is about to be killed and there is no terminal. An
      # error discarded here is a desktop that silently ends up with no shell
      # and no account of why — which is exactly what happened before.
      mkdir -p "$STATE_DIR"
      setsid "$0" --detached "$cmd" "$@" < /dev/null >> "$LOG_FILE" 2>&1 &
      exit 0
    fi

    # Every step, because a failure here cannot be reproduced interactively —
    # it only happens when the caller is the shell being replaced.
    set -x

    log "request: $cmd $* (from $(current_theme))"

    case "$cmd" in
      set)  [ "$#" -ge 1 ] || die "set needs a theme name"; switch_to "$1" ;;
      next) switch_to "$(step_theme 1)" ;;
      prev) switch_to "$(step_theme -1)" ;;
    esac
    ;;

  lock)
    # The lock screen is per theme, so it is launched by path rather than by
    # config name. -n (--no-duplicate) matters: a second locker while one is
    # already holding the lock would fail, and this makes it a no-op instead.
    #
    # exec, so the caller's process IS the locker. Never background this: if the
    # locker dies while the compositor still holds the lock, the session is
    # stuck and only a TTY can recover it.
    exec quickshell -p "$THEME_ROOT/$(current_theme)/lock/shell.qml" -n "$@"
    ;;

  current) current_theme ;;
  list)    printf '%s\n' $THEMES ;;

  ipc)
    exec quickshell -c "$(current_theme)" ipc "$@"
    ;;

  *)
    die "unknown command: $cmd"
    ;;
esac
