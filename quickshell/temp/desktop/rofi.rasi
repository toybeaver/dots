/* Rofi — flat launcher for the temp theme.
 *
 * A THEME file, loaded by ../../../.config/rofi/config.rasi through the
 * active-theme symlink. Appearance only; behaviour lives in that file.
 *
 * Opaque and square, for the same reason as this theme's mako: blur is off
 * compositor-wide (desktop/hypr.lua), so translucency would show raw unblurred
 * windows rather than frost.
 *
 * `transparency: "real"` is still set even though nothing here is translucent.
 * Without it rofi composites against an opaque backing of its own choosing, and
 * the rounded/square corners it draws get filled in.
 */

* {
    surface:     #000000FF;
    rim:         #B4B4B4FF;

    fg:          #FFFFFF;
    fg-dim:      #8A8A8AFF;

    /* The selection is a solid white bar with inverted text, not a tinted pane.
     * A translucent highlight needs something behind it to tint; against opaque
     * black it would just read as dark grey. */
    accent:      #FFFFFFFF;
    on-accent:   #000000FF;
    transparent: #00000000;

    background-color: @transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @surface;

    /* Unlike the glass theme, this one keeps a border. An opaque black panel on
     * a dark wallpaper has no edge of its own. */
    border:        1px;
    border-color:  @rim;
    border-radius: 0;

    width:   42%;
    padding: 0;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  14px;
    spacing:  10px;
}

inputbar {
    children:     [ prompt, entry ];
    spacing:      10px;
    padding:      2px 6px 10px 6px;
    border:       0 0 1px 0;
    border-color: @rim;
}

/* Oswald for the prompt, echoing the sidebar numerals and the mako title. */
prompt {
    font:           "Oswald SemiBold 13";
    text-color:     @fg;
    vertical-align: 0.5;
}

entry {
    font:              "Noto Sans 12";
    text-color:        @fg;
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    cursor-color:      @fg;
    vertical-align:    0.5;
}

listview {
    lines:     14;
    columns:   1;
    scrollbar: false;
    spacing:   2px;

    /* rofi's built-in default is `border: 2px dash 0px 0px`, which draws a
     * dashed rule under the input bar. The inputbar already has its own
     * separator, so this must be cleared explicitly or you get both. */
    border:    0;
}

element {
    padding:       7px 10px;
    border-radius: 0;
    spacing:       8px;
}

element normal.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @on-accent;
}

element-text {
    font:       "Noto Sans 12";
    text-color: inherit;

    /* Must be transparent, not `inherit`. Inheriting takes the element's
     * background *value* and paints it a second time over the element that
     * already drew it. Only the element paints the surface. */
    background-color: @transparent;
    vertical-align:   0.5;
}
