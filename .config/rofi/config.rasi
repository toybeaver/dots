/* Rofi — glass launcher, matching the mako notifications and snek sidebar.
 *
 * Like mako, the frosting is done by the compositor: the rofi-glass layer rule
 * in hyprland.lua matches the "rofi" namespace. This file supplies what the
 * blur shows through — translucency, the rounded shape and the hairline rim.
 *
 * transparency: "real" is load-bearing. Without it rofi composites against an
 * opaque backing and the alpha below does nothing.
 *
 * Layout is deliberately the stock drun shape (prompt + entry above a plain
 * list, no icons); only the styling and typography changed.
 */

configuration {
    modes:               "drun";
    show-icons:          false;
    drun-display-format: "{name} [<span size='small' style='italic'>({generic})</span>]";
}

* {
    /* Same dark glass and rim as mako, but denser: 0.70 here against mako's
     * 0.60. Mako is small and transient; rofi is a large surface you read a
     * list on, so it carries a bit more body.
     *
     * Legibility over bright content comes mostly from
     * decoration.blur.brightness in hyprland.lua, which darkens what the blur
     * samples. Verified against a white terminal placed behind rofi. Raising
     * blur size would not help — blur preserves average brightness. */
    glass:       #0E1118B3;

    /* Only the inputbar divider uses this now — the window border is gone.
     * Deliberately faint: at 0x40 it read as a pale outline rather than a
     * separator. */
    rim:         #FFFFFF1F;

    /* fg is the shell's body text. fg-bright is the same hue pushed further
     * toward white, used where text needs to lead rather than sit back: what
     * you type, and the selected row. */
    fg:          #EDF1F7;
    fg-bright:   #FFFFFF;
    fg-dim:      #EDF1F799;

    /* The selection is a pane of coloured glass, not a solid slab — it has to
     * let the frost behind it through like everything else here does. Neon rose
     * is the one hue gon's magenta and alucard's crimson share. */
    accent:      #FF3D8A66;
    transparent: #00000000;

    background-color: @transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @glass;

    /* No border. Against near-black wallpapers a hairline rim reads as a pale
     * outline stuck around the panel; the dark tint defines the shape on its
     * own. */
    border:        0;
    border-radius: 10px;

    /* Centred — rofi's default, so no location/offset is set at all.
     *
     * It previously sat top-left beside the sidebar, pinned to the window grid.
     * That was tuned when window borders were the old green; against the neon
     * theme a centred panel reads better. If it ever moves back, note that rofi
     * already honours the sidebar's 45px exclusive zone, so offsets are spacing
     * rather than a correction for the bar's width — and keep them small, or
     * the active window's border peeks through the gap beside it. */

    width:   42%;
    padding: 0;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  14px;
    spacing:  10px;
}

inputbar {
    children:     [ prompt, entry ];
    spacing:      10px;
    padding:      2px 6px 10px 6px;
    border:       0 0 1px 0;
    border-color: @rim;
}

/* Oswald for the prompt, echoing the sidebar numerals and the mako title. */
prompt {
    font:           "Oswald SemiBold 13";
    text-color:     @fg;
    vertical-align: 0.5;
}

entry {
    font:              "Noto Sans 12";
    text-color:        @fg-bright;
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    cursor-color:      @fg-bright;
    vertical-align:    0.5;
}

listview {
    lines:     14;
    columns:   1;
    scrollbar: false;
    spacing:   2px;

    /* rofi's built-in default is `border: 2px dash 0px 0px`, which draws a
     * dashed rule under the input bar. The inputbar already has its own hairline
     * separator, so this must be cleared explicitly or you get both. */
    border:    0;
}

element {
    padding:       7px 10px;
    border-radius: 7px;
    spacing:       8px;
}

element normal.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @fg-bright;
}

element-text {
    font:       "Noto Sans 12";
    text-color: inherit;

    /* Must be transparent, not `inherit`. Inheriting takes the element's
     * background *value* and paints it a second time over the element that
     * already drew it, so a translucent selection compounds — 0.40 becomes
     * 1-(1-0.40)^2 = 0.64 — and you get a darker box nested inside the row.
     * Only the element paints the surface. */
    background-color: @transparent;
    vertical-align:   0.5;
}
