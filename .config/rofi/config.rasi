/* Rofi — glass launcher, matching the mako notifications and snek sidebar.
 *
 * Like mako, the frosting is done by the compositor: the rofi-glass layer rule
 * in hyprland.lua matches the "rofi" namespace. This file supplies what the
 * blur shows through — translucency, the rounded shape and the hairline rim.
 *
 * transparency: "real" is load-bearing. Without it rofi composites against an
 * opaque backing and the alpha below does nothing.
 *
 * Layout is deliberately the stock drun shape (prompt + entry above a plain
 * list, no icons); only the styling and typography changed.
 */

configuration {
    modes:               "drun";
    show-icons:          false;
    drun-display-format: "{name} [<span size='small' style='italic'>({generic})</span>]";
}

* {
    /* Same sage frost and rim as mako, but denser: 0.50 here against mako's
     * 0.20. Mako is small and transient and usually lands on dark chrome; rofi
     * is a large surface you actually read a list on, and at 0.20 the backdrop
     * competed with the text badly over bright content. Drop to #7E9A8833 for
     * an exact mako match if the extra transparency is worth the legibility. */
    glass:       #7E9A8880;
    rim:         #FFFFFF40;

    /* fg is the shell's body cream. fg-bright is the same hue pushed toward
     * white, used where text needs to lead rather than sit back: what you type,
     * and the selected row. */
    fg:          #DCDDAA;
    fg-bright:   #F4F5E4;
    fg-dim:      #DCDDAA99;

    /* The selection is a pane of green glass, not a solid slab — it has to let
     * the frost behind it through like everything else here does. */
    accent:      #3EB26166;
    transparent: #00000000;

    background-color: @transparent;
    text-color:       @fg;
}

window {
    transparency:     "real";
    background-color: @glass;

    border:        1px;
    border-color:  @rim;
    border-radius: 10px;

    /* Top-left, beside the snek sidebar. rofi already honours the sidebar's
     * 45px exclusive zone — measured landing at x=45 with zero offset — so
     * these are not a correction for the bar's width.
     *
     * They line rofi up with the window grid instead: y-offset matches
     * general.gaps_out (7), so rofi occupies the same slot a tiled window
     * would, landing at 51,7. Keep them small. Hyprland draws a green active
     * border on the window underneath, and a larger offset opens a gap for
     * that border to peek through beside rofi. */
    location: north west;
    x-offset: 6;
    y-offset: 7;

    width:   42%;
    padding: 0;
}

mainbox {
    children: [ inputbar, listview ];
    padding:  14px;
    spacing:  10px;
}

inputbar {
    children:     [ prompt, entry ];
    spacing:      10px;
    padding:      2px 6px 10px 6px;
    border:       0 0 1px 0;
    border-color: @rim;
}

/* Oswald for the prompt, echoing the sidebar numerals and the mako title. */
prompt {
    font:           "Oswald SemiBold 13";
    text-color:     @fg;
    vertical-align: 0.5;
}

entry {
    font:              "Noto Sans 12";
    text-color:        @fg-bright;
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    cursor-color:      @fg-bright;
    vertical-align:    0.5;
}

listview {
    lines:     14;
    columns:   1;
    scrollbar: false;
    spacing:   2px;

    /* rofi's built-in default is `border: 2px dash 0px 0px`, which draws a
     * dashed rule under the input bar. The inputbar already has its own hairline
     * separator, so this must be cleared explicitly or you get both. */
    border:    0;
}

element {
    padding:       7px 10px;
    border-radius: 7px;
    spacing:       8px;
}

element normal.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @fg-bright;
}

element-text {
    font:       "Noto Sans 12";
    text-color: inherit;

    /* Must be transparent, not `inherit`. Inheriting takes the element's
     * background *value* and paints it a second time over the element that
     * already drew it, so a translucent selection compounds — 0.40 becomes
     * 1-(1-0.40)^2 = 0.64 — and you get a darker box nested inside the row.
     * Only the element paints the surface. */
    background-color: @transparent;
    vertical-align:   0.5;
}
