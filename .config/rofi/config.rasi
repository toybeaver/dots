/* Rofi — behaviour only. The look comes from the active theme.
 *
 * Split deliberately: modes, icons and display format are the same whichever
 * theme is running, so they live here and are never duplicated. Everything
 * visual lives in <theme>/desktop/rofi.rasi and is reached through the symlink
 * below, which bin/shell-theme repoints on every switch.
 *
 * The @theme path is absolute and points into ~/.local/state rather than at a
 * theme directory, so this file never has to name a theme.
 *
 * If the link is missing — a fresh checkout that has not run `shell-theme
 * start` yet — rofi falls back to its own default theme and still opens. It
 * will look wrong, not broken.
 */

configuration {
    modes:               "drun";
    show-icons:          false;
    drun-display-format: "{name} [<span size='small' style='italic'>({generic})</span>]";
}

@theme "/home/toyb/.local/state/dots/active/rofi.rasi"
