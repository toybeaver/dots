# Mako — glass notifications, matching the snek sidebar.
#
# This is real frosted glass, unlike the sidebar. The sidebar reserves an
# exclusive zone and sits over a near-flat wallpaper, so there is nothing
# behind it to blur; notifications float over actual window content, so
# Hyprland's blur has plenty of detail to work with.
#
# The compositor does the frosting, via the mako-glass layer rule in
# hyprland.lua matched on the "notifications" namespace. This file supplies
# what the blur shows through: translucency, the rounded shape, and the
# hairline rim.

font=Noto Sans 12
markup=1
format=<span font_family="Oswald" size="large" weight="600">%s</span>\n%b

# Dark glass. Earlier revisions used a light frost (sage, then cool neutral),
# which suited the old green wallpaper; against the near-black gon / alucard
# wallpapers a pale panel reads as a bright slab stuck on the screen.
#
# Going dark also inverts the old readability problem. A light frost fought the
# text and needed blur brightness pulled down to 0.60 to stay legible over
# bright content; a dark tint under near-white text does that job itself, so
# blur brightness is back up and the blur shows real colour again.
#
# Two things had to be right together, and they are easy to confuse:
#
#   - This alpha. At 0.68 the box looked solid: only 32% of the backdrop came
#     through, and 32% of dark window content is still dark.
#   - Hyprland's blur *strength*, in hyprland.lua. That one is counterintuitive
#     — too much blur is what makes a panel look milky. At size 6 / passes 3 the
#     backdrop was homogenised into flat colour, so nothing behind stayed
#     recognisable. Glass needs shapes softened, not erased. See the note there
#     before raising it.
#
# Readability over bright content is handled in hyprland.lua, not here:
# decoration.blur.brightness darkens what the blur samples. That is the knob to
# reach for, because blur softens detail without darkening it — a blurred white
# page is still white, so raising blur size does nothing for legibility, and
# raising this alpha buys it only by spending the transparency. With brightness
# at 0.60 this can stay low.
background-color=#0E111899
text-color=#EDF1F7FF
border-color=#FFFFFF40
progress-color=over #FF3D8A66

# No border. A hairline rim reads as a pale outline stuck around the panel
# against these near-black wallpapers; the dark tint alone defines the shape.
# Critical notifications re-enable it below, since the coloured rim is their
# only urgency signal.
border-size=0
border-radius=10

padding=14
margin=10
outer-margin=12

width=400
height=170

icon-location=left
max-icon-size=48
icon-border-radius=6

anchor=top-right
layer=top
max-visible=5
history=1

# Notifications previously persisted forever because no config existed at all
# and mako's built-in default is 0 (never expire).
default-timeout=5000

[urgency=low]
background-color=#0E11188C
default-timeout=3000

[urgency=critical]
border-size=2
border-color=#FF4060CC
default-timeout=20000
